<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>GodotWildJam96</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="GodotWildJam96.Sim\GodotWildJam96.Sim.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- GodotWildJam96.Sim lives in a subfolder of this project. Without this, the default
         **/*.cs compile glob sweeps up Sim's own generated obj/ files (AssemblyInfo.cs,
         AssemblyAttributes.cs), duplicating every assembly-level attribute and failing the
         build with CS0579. -->
    <Compile Remove="GodotWildJam96.Sim\**\*.cs" />
    <EmbeddedResource Remove="GodotWildJam96.Sim\**\*" />
    <None Remove="GodotWildJam96.Sim\**\*" />
  </ItemGroup>
</Project>